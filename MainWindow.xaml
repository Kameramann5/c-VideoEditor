<Window x:Class="VideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        Title="Video Editor" Height="750" Width="1200">
   


   <TabControl>
        <!-- ПЕРВАЯ ВКЛАДКА: МОНТАЖ -->
        <TabItem Header="Мызыка на видео">
        <Grid Margin="15">
    <Grid.ColumnDefinitions>
        <!-- Левая часть: Настройки (фиксированная ширина) -->
        <ColumnDefinition Width="600"/>
        <!-- Правая часть: Предпросмотр (занимает всё остальное место) -->
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <!-- ЛЕВАЯ КОЛОНКА -->

 <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,15,0">
   <StackPanel Margin="20"> 
        
        <TextBlock Name="StatusText" Text="Загрузите файлы" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        
          <Button Content="1. Выбрать Видео" Click="SelectVideo_Click" Height="30" Width="120" Margin="5"/>
    <Button Content="2. Выбрать Аудио" Click="SelectAudio_Click" Height="30" Width="120" Margin="5"/>
    
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
    <TextBlock Text="Длительность видео: " FontWeight="SemiBold"/>
    <TextBlock Name="VideoDurationText" Text="0.0" FontWeight="Bold" Foreground="DodgerBlue"/>
    <TextBlock Text=" сек."/>
</StackPanel>
        <!-- Контейнер для визуализации полосок -->
        <Grid Height="60" Background="#333" Margin="0,10">
            <Rectangle Name="VideoBar" Fill="DodgerBlue" Height="20" VerticalAlignment="Top" Width="0" HorizontalAlignment="Left"/>
            <Rectangle Name="AudioBar" Fill="Orange" Height="20" VerticalAlignment="Bottom" Width="0" HorizontalAlignment="Left" Margin="0,0,0,5"/>
        </Grid>

<StackPanel Margin="0,20">
    <TextBlock Text="Настройка отрезка аудио" HorizontalAlignment="Center" Margin="0,0,0,15" FontSize="14" FontWeight="Bold"/>
    
    <!-- Секция НАЧАЛА -->
    <StackPanel Margin="0,0,0,15">
        <DockPanel LastChildFill="False">
            <TextBlock Text="Начало отрезка (Зеленый):" FontSize="11" Foreground="DarkGreen"/>
         <TextBlock Text="{Binding ElementName=StartSlider, Path=Value, StringFormat={}{0:F1} сек.}" 
           DockPanel.Dock="Right" FontWeight="Bold" Foreground="DarkGreen"/>
        </DockPanel>
        <Slider Name="StartSlider" 
                Minimum="0" Maximum="100" Value="0"
                ValueChanged="StartSlider_ValueChanged"
                Foreground="Green" Height="30"/>
    </StackPanel>



    <!-- Итоговая информация -->
    <Border Background="#F0F0F0" CornerRadius="5" Padding="10" Margin="0,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Итоговый диапазон: " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ElementName=StartSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="Green" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text=" — " VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock Text="{Binding ElementName=EndSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="Blue" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text=" сек." VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</StackPanel>







        <Button Content="Склеить и Сохранить" Click="MergeButton_Click" Height="40" Margin="0,20,0,0"/>
        <ProgressBar Name="ProgBar" Height="10" Margin="0,10,0,0"/>


    </StackPanel> <!-- Закрываем пакет -->


        </ScrollViewer>

          <!-- ПРАВАЯ КОЛОНКА (Видео) -->
    <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="500"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black" CornerRadius="8" ClipToBounds="True">
            <MediaElement Name="ResultPreview" 
                          LoadedBehavior="Manual" 
                              MediaEnded="ResultPreview_MediaEnded" 
                          UnloadedBehavior="Stop" 
                          Stretch="Uniform"/>
                          <!-- Невидимый плеер для аудио -->

        </Border>
        <!-- Ползунок времени видео -->
<StackPanel Grid.Row="1" Margin="10,0">
    <Slider Name="TimelineSlider" Minimum="0" Maximum="100" 
            Thumb.DragStarted="TimelineSlider_DragStarted" 
            Thumb.DragCompleted="TimelineSlider_DragCompleted"
            ValueChanged="TimelineSlider_ValueChanged"/>
    
    <DockPanel LastChildFill="False" Margin="0,2,0,0">
        <TextBlock Name="CurrentTimeText" Text="00:00" FontSize="11" DockPanel.Dock="Left"/>
        <TextBlock Name="TotalTimeText" Text="00:00" FontSize="11" DockPanel.Dock="Right"/>
    </DockPanel>
</StackPanel>
<MediaElement Name="AudioPreview" LoadedBehavior="Manual" Volume="0.5" Visibility="Collapsed" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="▶ Play" Click="PlayPreview_Click" Width="80" Height="30" Margin="5"/>
            <Button Content="Pause" Click="PausePreview_Click" Width="80" Height="30" Margin="5"/>
        </StackPanel>
    </Grid>
</Grid>
   </TabItem>

        <!-- ВТОРАЯ ВКЛАДКА: ТЕСТОВАЯ -->
        <TabItem Header="Обрезать видео">
            <Grid Background="#f9f9f9">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Здесь будет твой новый функционал" FontSize="20" Foreground="Gray"/>
                    <Button Content="Тестовая кнопка" Width="150" Height="40" Margin="10"/>
                </StackPanel>
            </Grid>
        </TabItem>

 </TabControl>
</Window>
